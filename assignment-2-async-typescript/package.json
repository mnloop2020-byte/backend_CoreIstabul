{
  "name": "async-task-management-ts",
  "version": "1.0.0",
  "description": "Async task management backend with TypeScript and ES Modules (Session 2 assignment)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "keywords": [],
  "author": "Mohammed",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
