# Copy to .env and fill in the values. Never commit .env.
PORT=3000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/library_auth_db?schema=public"

# Secrets used to sign the JWTs. Use two different long random strings (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING

# How long each token is valid ("15m" = 15 minutes, "7d" = 7 days)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# The first ADMIN account, created by `npm run db:seed`
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
