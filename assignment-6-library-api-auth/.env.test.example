# Copy to .env.test and fill in the values. Never commit .env.test.
# The tests delete and re-create all data, so they use their own database,
# never the one in .env.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/library_auth_test_db?schema=public"

JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
