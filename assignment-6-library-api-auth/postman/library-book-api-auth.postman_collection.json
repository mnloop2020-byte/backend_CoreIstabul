    {
      "name": "3. Books as ADMIN",
      "description": "The requests from the previous version, unchanged except for the ADMIN token.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminAccessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Success cases",
          "item": [
            {
              "name": "Get all books",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/books"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('Returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Create book",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/books",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"Andrew Hunt & David Thomas\",\n  \"genre\": \"Programming\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                      "const book = pm.response.json();",
                      "pm.test('available defaults to true', () => pm.expect(book.available).to.eql(true));",
                      "pm.collectionVariables.set('bookId', book.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get book by id",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/books/{{bookId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('Correct book', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('bookId'))));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Update book (PATCH)",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/books/{{bookId}}",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"available\": false\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('available is now false', () => pm.expect(pm.response.json().available).to.eql(false));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Delete book",
              "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/books/{{bookId}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Failure cases",
          "item": [
            {
              "name": "Get deleted book -> 404",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/books/{{bookId}}"
