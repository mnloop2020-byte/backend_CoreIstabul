{
  "name": "library-book-api",
  "version": "1.0.0",
  "description": "Library Book Management REST API with Express 5, TypeScript and Zod (Session 4 assignment)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "keywords": [],
  "author": "Mohammed",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
